:root { color: rgb(210,228,238); font-size: 14px; }
.top { position: absolute; top: 28px; left: 38px; right: 38px; flex-direction: row; justify-content: space-between; }
.brand { font-size: 23px; -unity-font-style: bold; letter-spacing: 5px; }
.sector { color: rgb(128,167,187); letter-spacing: 3px; padding-top: 8px; font-size: 12px; }
.mission { position: absolute; left: 38px; top: 110px; border-left-width: 2px; border-left-color: rgb(64,206,221); padding-left: 17px; padding-right: 22px; padding-top: 10px; padding-bottom: 12px; background-color: rgba(4,12,22,.55); }
.eyebrow { font-size: 10px; color: rgb(111,154,176); letter-spacing: 2px; }
.objective { font-size: 25px; margin-top: 8px; margin-bottom: 9px; white-space: normal; }
.detail { font-size: 12px; color: rgb(137,193,205); }
.reticle { position: absolute; left: 49.5%; top: 49%; font-size: 24px; color: rgba(174,219,231,.55); }
.marker { position: absolute; color: rgb(99,217,224); font-size: 12px; letter-spacing: 1px; }
.telemetry { position: absolute; bottom: 96px; left: 38px; }
.speed { font-size: 55px; -unity-font-style: bold; }
.drive { margin-top: 14px; color: rgb(100,212,220); font-size: 11px; letter-spacing: 2px; }
.bottom { position: absolute; bottom: 28px; left: 38px; }
.controls { color: rgb(117,149,171); font-size: 10px; letter-spacing: 1px; margin-top: 5px; }
.notice { position: absolute; bottom: 30px; right: 38px; font-size: 10px; color: rgb(112,159,175); letter-spacing: 1px; }
.menu { position: absolute; width: 460px; left: 50%; top: 23%; margin-left: -230px; padding: 28px; background-color: rgba(5,15,28,.97); border-top-width: 2px; border-top-color: rgb(70,214,229); }
.menu-copy { white-space: normal; margin-bottom: 25px; font-size: 14px; color: rgb(142,180,197); }
Button { background-color: rgb(19,44,60); color: rgb(204,235,243); height: 42px; margin-top: 8px; border-width: 0; }
.surface-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding-left: 38px; padding-right: 38px; padding-top: 32px; padding-bottom: 28px; }
.surface-title { font-size: 23px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(228,246,247); background-color: rgba(4,14,25,.8); padding: 12px; }
.surface-subtitle { font-size: 12px; color: rgb(141,227,219); background-color: rgba(4,14,25,.8); padding-left: 12px; padding-bottom: 10px; }
.surface-signal { position: absolute; top: 105px; right: 38px; min-width: 330px; font-size: 15px; color: rgb(141,246,221); background-color: rgba(4,14,25,.85); padding: 15px; }
.surface-total { position: absolute; top: 212px; right: 38px; min-width: 330px; font-size: 12px; color: rgb(163,205,222); background-color: rgba(4,14,25,.85); padding: 12px; }
.surface-objective { position: absolute; top: 105px; left: 38px; max-width: 520px; font-size: 15px; color: rgb(240,227,191); background-color: rgba(4,14,25,.87); padding: 14px; white-space: normal; }
.surface-suit { position: absolute; bottom: 88px; right: 38px; font-size: 15px; color: rgb(200,239,255); background-color: rgba(4,14,25,.87); padding: 14px; }
.ground-reticle { position: absolute; top: 50%; left: 50%; width: 32px; height: 32px; margin-left: -16px; margin-top: -16px; font-size: 27px; -unity-text-align: middle-center; color: white; }
.ground-aim-dot { position: absolute; top: 50%; left: 50%; width: 7px; height: 7px; margin-left: -3.5px; margin-top: -3.5px; border-radius: 4px; border-width: 1px; border-color: rgb(12,20,27); background-color: white; }
.ground-marker { position: absolute; width: 200px; font-size: 12px; -unity-text-align: middle-center; background-color: rgba(4,14,25,.6); padding: 4px; }
.surface-message { position: absolute; bottom: 86px; left: 38px; max-width: 850px; white-space: normal; font-size: 15px; color: rgb(222,245,236); background-color: rgba(4,14,25,.85); padding: 14px; }
.surface-controls { position: absolute; bottom: 24px; left: 38px; right: 38px; font-size: 12px; color: rgb(158,214,226); background-color: rgba(4,14,25,.88); padding: 10px; }
Button:hover { background-color: rgb(32,83,102); }
.survey-card { position: absolute; top: 112px; right: 38px; width: 292px; padding: 20px; background-color: rgba(4,14,25,.88); border-top-width: 2px; border-top-color: rgb(64,206,221); }
.survey-title { font-size: 23px; margin-top: 12px; white-space: normal; }
.survey-state { font-size: 11px; color: rgb(89,207,213); margin-top: 7px; margin-bottom: 16px; }
.survey-details { font-size: 13px; color: rgb(183,206,217); white-space: normal; }
.scan-hint { font-size: 11px; margin-top: 20px; color: rgb(92,226,224); white-space: normal; }
.scan-track { height: 4px; margin-top: 13px; background-color: rgb(22,48,61); }
.scan-fill { height: 4px; width: 0; background-color: rgb(94,231,227); }
.survey-help { font-size: 10px; color: rgb(130,165,183); margin-top: 16px; white-space: normal; }
.transmission { position: absolute; top: 78px; left: 38px; right: 38px; font-size: 11px; color: rgb(104,178,195); }
.journal { position: absolute; left: 50%; margin-left: -260px; top: 20%; width: 520px; padding: 28px; background-color: rgba(4,14,25,.97); border-top-width: 2px; border-top-color: rgb(64,206,221); }
.resources { position: absolute; top: 58px; right: 38px; font-size: 12px; color: rgb(111,224,211); }
.colony-context { position: absolute; bottom: 102px; right: 38px; width: 510px; font-size: 12px; white-space: normal; color: rgb(103,222,211); background-color: rgba(4,14,25,.8); padding: 16px; }
.colony-panel { position: absolute; left: 50%; margin-left: -310px; top: 85px; width: 620px; padding: 20px; background-color: rgba(4,14,25,.98); border-top-width: 2px; border-top-color: rgb(64,206,221); }
.building-button { height: 60px; font-size: 12px; white-space: normal; -unity-text-align: middle-left; padding-left: 14px; }
.combat-health { position: absolute; bottom: 275px; left: 38px; color: rgb(124,226,232); font-size: 13px; background-color: rgba(4,14,25,.85); padding: 10px; }
.combat-message { position: absolute; top: 265px; left: 38px; width: 410px; color: rgb(245,172,121); font-size: 12px; white-space: normal; }
.combat-target { position: absolute; color: rgb(255,127,108); font-size: 12px; background-color: rgba(22,6,8,.8); padding: 8px; }
.combat-objective { position: absolute; top: 325px; left: 38px; width: 410px; white-space: normal; color: rgb(245,172,121); font-size: 12px; }
.sector-map { position: absolute; left: 8%; right: 8%; top: 100px; padding: 22px; background-color: rgb(4,14,25); border-top-width: 2px; border-top-color: rgb(64,206,221); }
.sector-map Button { height: 34px; margin-top: 4px; }
.sector-map .survey-help { margin-top: 6px; }
.sector-map .survey-title { margin-top: 6px; font-size: 21px; }
.system-column { width: 33%; padding: 12px; }
.planet-button { height: 42px; font-size: 11px; white-space: normal; }
.sector-message { position: absolute; top: 330px; left: 38px; width: 405px; white-space: normal; font-size: 12px; color: rgb(155,210,220); }
.sector-waypoint { position: absolute; color: rgb(140,225,220); background-color: rgba(4,14,25,.75); padding: 8px; font-size: 12px; }
.victory-status { position: absolute; top: 58px; left: 38px; color: rgb(135,204,214); font-size: 11px; }
.mission { max-width: 580px; }
Button { transition-property: background-color; transition-duration: .15s; }
